{
  "name": "bode",
  "version": "2.1.2",
  "description": "Local CLI that orchestrates AI coding work through configurable phases",
  "type": "module",
  "author": "Kakunyn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KakunynQA/bode.git"
  },
  "bin": {
    "bode": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "src/skills/defaults/",
    "src/assets/bode.art",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "node scripts/build-skills.mjs && node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "check": "tsc --noEmit",
    "lint": "eslint src/ tests/ --config eslint.config.mjs",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "node scripts/test.mjs",
    "test:coverage": "c8 node scripts/test.mjs",
    "test:all": "node scripts/test.mjs --all"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.0",
    "commander": "^14.0.3",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "react-devtools-core": "^4.28.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.29",
    "c8": "^11.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
